#!/bin/sh
set -eu

# codex-switcher is a small POSIX shell wrapper around Codex CLI.
# It manages profiles for OpenAI-compatible relays (must implement GET /models
# and the Responses API). When a relay profile is added, sync-models queries
# <base_url>/models and merges the discovered models into the profile model
# catalog, so /model can switch between all supported models.

# Provider tools can pollute HOME/CODEX_HOME/CODEX_SWITCHER_HOME. This wrapper
# always returns to the primary Codex home even when those variables are
# polluted. Override with CODEX_SWITCHER_CODEX_HOME when the Codex home is not
# the default $HOME/.codex.
codex_home=${CODEX_SWITCHER_CODEX_HOME:-$HOME/.codex}

find_codex() {
  if [ -n "${CODEX_SWITCHER_CODEX_BIN:-}" ] && [ -x "$CODEX_SWITCHER_CODEX_BIN" ]; then
    printf '%s\n' "$CODEX_SWITCHER_CODEX_BIN"
    return 0
  fi

  candidate=$(command -v codex 2>/dev/null || true)
  [ -n "$candidate" ] || candidate=''
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  # Covers VS Code Codex extensions on Linux and macOS, including x64/arm64.
  for candidate in \
    "$HOME"/.vscode/extensions/openai.chatgpt-*/bin/*/codex \
    "$HOME"/.vscode/extensions/openai.chatgpt-*/codex; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

find_vscode() {
  if [ -n "${CODEX_SWITCHER_VSCODE_BIN:-}" ] && [ -x "$CODEX_SWITCHER_VSCODE_BIN" ]; then
    printf '%s\n' "$CODEX_SWITCHER_VSCODE_BIN"
    return 0
  fi

  candidate=$(command -v code 2>/dev/null || true)
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  candidate=$(command -v code-insiders 2>/dev/null || true)
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  # Common macOS application-bundle locations.
  for candidate in \
    "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code" \
    "$HOME/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code" \
    "/Applications/Visual Studio Code - Insiders.app/Contents/Resources/app/bin/code"; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

codex_bin=$(find_codex || true)
if [ -z "$codex_bin" ]; then
  echo "找不到 Codex CLI。请先安装 Codex，或设置 CODEX_SWITCHER_CODEX_BIN。" >&2
  exit 1
fi

die() {
  echo "错误：$*" >&2
  exit 1
}

toml_value() {
  file=$1
  key=$2
  [ -f "$file" ] || return 1
  sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$file" | sed -n '1p'
}

key_is_placeholder() {
  case "$1" in
    ''|PASTE_*|REPLACE_*|YOUR_*|'< '*|'<'*) return 0 ;;
    *) [ ${#1} -lt 10 ] && return 0 || return 1 ;;
  esac
}

write_profile_template() {
  name=$1
  target="$codex_home/$name.config.toml"
  tmp="$target.codex-switcher-tmp.$$"
  mkdir -p "$codex_home"
  {
    printf 'model_provider = "openai-proxy"\n'
    printf 'model = "gpt-5.5"\n'
    printf 'review_model = "gpt-5.5"\n'
    printf 'model_reasoning_effort = "xhigh"\n'
    printf 'disable_response_storage = true\n'
    printf 'network_access = "enabled"\n'
    printf 'model_catalog_json = "%s-models.json"\n' "$name"
    printf '\n'
    printf '[model_providers.openai-proxy]\n'
    printf 'name = "OpenAI 兼容中转"\n'
    printf 'base_url = "https://你的中转站/v1"\n'
    printf 'wire_api = "responses"\n'
    printf 'requires_openai_auth = true\n'
    printf 'experimental_bearer_token = "<你的Key>"\n'
  } > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$target"
}

sync_models() {
  name=$1
  case "$name" in
    official|default|reset|restore)
      echo "错误：内置 Profile 不需要同步模型。" >&2
      return 1
      ;;
  esac

  profile_file="$codex_home/$name.config.toml"
  [ -f "$profile_file" ] || { echo "错误：不存在 profile：$name" >&2; return 1; }

  # deb 系统安装场景：~/.codex 没有来源目录时，从 /usr/share 初始化
  if [ ! -f "$codex_home/deepseek-models.json" ] && [ -f /usr/share/codex-switcher/assets/deepseek-models.json ]; then
    mkdir -p "$codex_home"
    cp /usr/share/codex-switcher/assets/deepseek-models.json "$codex_home/deepseek-models.json"
    chmod 600 "$codex_home/deepseek-models.json"
    echo "已从 /usr/share/codex-switcher 初始化 deepseek-models.json"
  fi

  base_url=$(toml_value "$profile_file" base_url || true)
  [ -n "$base_url" ] || {
    echo "错误：Profile $name 未配置 base_url，请先 codex-switcher edit $name 填写中转站地址。" >&2
    return 1
  }

  key=$(toml_value "$profile_file" experimental_bearer_token || true)
  if key_is_placeholder "$key"; then
    env_key_name=$(toml_value "$profile_file" env_key || true)
    if [ -n "$env_key_name" ]; then
      key=$(printenv "$env_key_name" 2>/dev/null || true)
    fi
  fi
  if key_is_placeholder "$key"; then
    echo "错误：Profile $name 未配置有效 Key（experimental_bearer_token 或 env_key）。" >&2
    return 1
  fi

  command -v curl >/dev/null 2>&1 || { echo "错误：需要 curl 才能同步模型。" >&2; return 1; }
  command -v python3 >/dev/null 2>&1 || { echo "错误：需要 python3 才能同步模型（用于合并 JSON）。" >&2; return 1; }

  case "$base_url" in
    */) base_url=${base_url%/} ;;
  esac
  models_url="${base_url}/models"

  tmp="$codex_home/.$name-sync.$$"
  rm -f "$tmp"
  trap 'rm -f "$tmp"' EXIT HUP INT TERM

  echo "正在查询模型列表：$models_url"
  http_code=$(curl -sS -m 20 -o "$tmp" -w '%{http_code}' -H "Authorization: Bearer $key" "$models_url" || true)
  if [ -z "$http_code" ]; then
    echo "错误：无法连接 $models_url（网络/代理/DNS）。" >&2
    return 1
  fi
  if [ "$http_code" != "200" ]; then
    echo "错误：查询 $models_url 失败（HTTP $http_code）。" >&2
    case "$http_code" in
      404) echo "  该中转站未实现 GET /models；本工具要求中转站支持 OpenAI 兼容的 /models 接口。" >&2 ;;
      401|403) echo "  中转站拒绝访问：Key 无效或没有权限，请检查 experimental_bearer_token。" >&2 ;;
    esac
    echo "  可向中转站确认支持的模型列表后手工配置模型目录。" >&2
    return 1
  fi
  [ -s "$tmp" ] || { echo "错误：$models_url 返回空响应。" >&2; return 1; }

  ids=$(python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    raise SystemExit(2)
print("\n".join(str(x.get("id","")) for x in d.get("data",[]) if x.get("id")))
' "$tmp" 2>/dev/null) || {
    echo "错误：无法解析 $models_url 的响应（不是标准 OpenAI /models JSON）。" >&2
    return 1
  }
  [ -n "$ids" ] || { echo "错误：$models_url 返回的模型列表为空（data 为空）。" >&2; return 1; }

  CODEX_SWITCHER_PROFILE="$name" CODEX_SWITCHER_HOME="$codex_home" CODEX_SWITCHER_IDS="$ids" python3 <<'PY'
import json, os, shutil

name = os.environ["CODEX_SWITCHER_PROFILE"]
codex_home = os.environ["CODEX_SWITCHER_HOME"]
catalog_path = os.path.join(codex_home, name + "-models.json")
ids = [line for line in os.environ.get("CODEX_SWITCHER_IDS", "").split() if line]
EXCLUDE = {"codex-auto-review"}

source_files = [
    os.path.join(codex_home, "models_cache.json"),
    os.path.join(codex_home, "deepseek-models.json"),
    catalog_path,
]
by_slug = {}
seen_paths = set()
for p in source_files:
    if not os.path.exists(p):
        continue
    real = os.path.realpath(p)
    if real in seen_paths:
        continue
    seen_paths.add(real)
    try:
        with open(p) as f:
            models = json.load(f).get("models", [])
    except Exception:
        continue
    for m in models:
        by_slug.setdefault(m.get("slug"), m)

existing = {}
if os.path.exists(catalog_path):
    try:
        with open(catalog_path) as f:
            for m in json.load(f).get("models", []):
                existing[m.get("slug")] = m
    except Exception:
        pass

added, skipped = [], []
for mid in ids:
    if mid in EXCLUDE:
        skipped.append((mid, "非用户可选模型"))
        continue
    if mid in existing:
        continue
    entry = by_slug.get(mid)
    if entry is None:
        skipped.append((mid, "无完整条目（models_cache.json / deepseek-models.json 均无）"))
        continue
    existing[mid] = entry
    added.append(mid)

models = sorted(existing.values(), key=lambda m: m.get("priority", 0), reverse=True)

if added or not os.path.exists(catalog_path):
    if os.path.exists(catalog_path):
        shutil.copy(catalog_path, catalog_path + ".bak")
    with open(catalog_path, "w") as f:
        json.dump({"models": models}, f, ensure_ascii=False, indent=1)
    os.chmod(catalog_path, 0o600)

if added:
    print("新增 %d 个模型：%s" % (len(added), "、".join(added)))
else:
    print("没有需要新增的模型。")
for mid, reason in skipped:
    print("跳过：%s（%s）" % (mid, reason))
print("模型目录：%s（共 %d 个）" % (catalog_path, len(models)))
print("/model 可用模型：" + "、".join(m.get("slug", "?") for m in models))
PY
  rc=$?
  [ "$rc" -eq 0 ] || return 1

  if ! grep -Eq '^[[:space:]]*model_catalog_json[[:space:]]*=' "$profile_file"; then
    cp "$profile_file" "$profile_file.bak"
    tmp2="$profile_file.codex-switcher-tmp.$$"
    {
      printf 'model_catalog_json = "%s-models.json"\n' "$name"
      cat "$profile_file"
    } > "$tmp2"
    chmod 600 "$tmp2"
    mv "$tmp2" "$profile_file"
    echo "已为 $profile_file 补上 model_catalog_json 配置。"
  fi
  return 0
}

prepare_official_environment() {
  unset CODEX_SWITCHER_HOME
  unset CODEX_SWITCHER_CODEX_BIN
  unset CODEX_SWITCHER_VSCODE_BIN
  unset CODEX_SWITCHER_EDITOR
  prepare_provider_environment
}

prepare_provider_environment() {
  unset ANTHROPIC_BASE_URL
  unset ANTHROPIC_AUTH_TOKEN
  unset OPENAI_BASE_URL
  unset OPENAI_API_KEY
}

valid_name() {
  case "$1" in
    ''|*[^A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

reserved_name() {
  case "$1" in
    list|create|edit|delete|remove|rm|sync-models|sessions|model|doctor|official|default|reset|restore|help|version|completion|__complete)
      return 0 ;;
    *) return 1 ;;
  esac
}

list_profiles() {
  {
    for file in "$codex_home"/*.config.toml; do
      [ -f "$file" ] || continue
      base=${file##*/}
      printf '%s\n' "${base%.config.toml}"
    done
  } | sort -u
}

list_profiles_json() {
  CODEX_SWITCHER_HOME="$codex_home" python3 <<'PY'
import json, os, re, sys

codex_home = os.environ["CODEX_SWITCHER_HOME"]
try:
    names = sorted(n[:-12] for n in os.listdir(codex_home) if n.endswith(".config.toml"))
except OSError:
    names = []
out = []
for name in names:
    path = os.path.join(codex_home, name + ".config.toml")
    model = base_url = catalog = key = ""
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                m = re.match(r'^\s*([A-Za-z0-9_]+)\s*=\s*"([^"]*)"', line)
                if not m:
                    continue
                k, v = m.group(1), m.group(2)
                if k == "model" and not model:
                    model = v
                elif k == "base_url" and not base_url:
                    base_url = v
                elif k == "model_catalog_json" and not catalog:
                    catalog = v
                elif k == "experimental_bearer_token" and not key:
                    key = v
    except OSError:
        pass
    key_ok = bool(key) and not (
        key.startswith("PASTE_") or key.startswith("REPLACE_") or key.startswith("YOUR_")
        or key.startswith("<") or len(key) < 10
    )
    out.append({"name": name, "model": model, "base_url": base_url, "catalog": catalog, "key_ok": key_ok})
json.dump(out, sys.stdout, ensure_ascii=False, indent=2)
print()
PY
}

list_profile_models() {
  name=$1
  target="$codex_home/$name.config.toml"
  catalog=$(toml_value "$target" model_catalog_json)
  [ -n "$catalog" ] || catalog="$name-models.json"
  catalog_file="$codex_home/$catalog"
  [ -f "$catalog_file" ] || die "模型目录不存在：$catalog_file；请先执行 codex-switcher sync-models $name"
  python3 -c '
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        d = json.load(f)
except Exception:
    sys.exit(2)
models = d.get("models", []) if isinstance(d, dict) else d
for m in models:
    if isinstance(m, dict) and m.get("slug"):
        print(m["slug"])
' "$catalog_file" 2>/dev/null || die "无法解析模型目录：$catalog_file"
}

set_profile_model() {
  name=$1
  new_model=$2
  target="$codex_home/$name.config.toml"
  python3 - "$target" "$new_model" <<'PY'
import sys

path, new_model = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as f:
    lines = f.readlines()
out = []
replaced = False
for line in lines:
    if line.startswith("model = "):
        out.append('model = "%s"\n' % new_model)
        replaced = True
    else:
        out.append(line)
if not replaced:
    out.insert(0, 'model = "%s"\n' % new_model)
with open(path, "w", encoding="utf-8") as f:
    f.writelines(out)
PY
}

list_sessions() {
  command -v python3 >/dev/null 2>&1 || die "需要 python3 才能列出会话。"
  CODEX_SWITCHER_HOME="$codex_home" python3 <<'PY'
import glob, json, os, re, sys
from datetime import datetime

codex_home = os.environ["CODEX_SWITCHER_HOME"]
sessions_dir = os.path.join(codex_home, "sessions")
rows = []

def local_time(ts):
    if not ts:
        return "未知"
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%d %H:%M")
    except Exception:
        return ts[:16].replace("T", " ")

if os.path.isdir(sessions_dir):
    for p in glob.glob(os.path.join(sessions_dir, "**", "*.jsonl"), recursive=True):
        ts = sid = cwd = provider = topic = None
        name_file = p + ".name"
        if os.path.isfile(name_file):
            try:
                with open(name_file, encoding="utf-8", errors="replace") as nf:
                    topic = nf.readline().strip() or None
            except OSError:
                pass
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                for line in f:
                    try:
                        d = json.loads(line)
                    except Exception:
                        continue
                    if not isinstance(d, dict):
                        continue
                    if d.get("type") == "session_meta":
                        pl = d.get("payload") or {}
                        sid = pl.get("session_id") or pl.get("id") or sid
                        cwd = pl.get("cwd") or cwd
                        provider = pl.get("model_provider") or provider
                        ts = pl.get("timestamp") or ts
                    elif topic is None and d.get("type") == "event_msg":
                        pl = d.get("payload") or {}
                        if pl.get("type") == "user_message":
                            topic = pl.get("message") or ""
                            topic = topic.strip() or None
                    if sid and ts and topic is not None:
                        break
        except OSError:
            continue
        if not sid:
            sid = os.path.basename(p)
        if topic is None:
            topic = ""
        folder_date = ""
        m = re.search(r"/sessions/(\d{4})/(\d{2})/(\d{2})/", p)
        if m:
            folder_date = "%s-%s-%s" % (m.group(1), m.group(2), m.group(3))
        try:
            size = os.path.getsize(p)
        except OSError:
            size = 0
        rows.append((ts or folder_date, ts, sid, provider or "", cwd or "", size, topic))

if not rows:
    print("没有找到会话：%s 不存在或为空" % sessions_dir)
    raise SystemExit(0)

rows.sort(key=lambda r: r[0])
lines = ["%-17s %-36s %-16s %8s  %-24s %s" % ("时间", "会话 ID", "Provider", "大小", "目录", "主题")]
for _sort_ts, ts, sid, provider, cwd, size, topic in rows:
    topic = " ".join(topic.split())
    if len(topic) > 60:
        topic = topic[:57] + "..."
    lines.append("%-17s %-36s %-16s %6dKB  %-24s %s" % (local_time(ts), sid, provider, size // 1024, cwd, topic))
out = "\n".join(lines) + "\n"
try:
    sys.stdout.write(out)
except BrokenPipeError:
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, sys.stdout.fileno())
PY
}

find_session_file() {
  sid=$1
  [ -n "$sid" ] || return 1
  CODEX_SWITCHER_HOME="$codex_home" CODEX_SWITCHER_SESSION_ID="$sid" python3 <<'PY'
import glob, json, os, sys

codex_home = os.environ["CODEX_SWITCHER_HOME"]
sid = os.environ["CODEX_SWITCHER_SESSION_ID"]
sessions_dir = os.path.join(codex_home, "sessions")
if not os.path.isdir(sessions_dir):
    raise SystemExit(0)
for p in glob.glob(os.path.join(sessions_dir, "**", "*.jsonl"), recursive=True):
    match = "-" + sid + ".jsonl" in os.path.basename(p)
    if not match:
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                for line in f:
                    try:
                        d = json.loads(line)
                    except Exception:
                        continue
                    if isinstance(d, dict) and d.get("type") == "session_meta":
                        pl = d.get("payload") or {}
                        if pl.get("session_id") == sid or pl.get("id") == sid:
                            match = True
                        break
        except OSError:
            continue
    if match:
        sys.stdout.write(p)
        raise SystemExit(0)
PY
}

session_topic() {
  path=$1
  [ -f "$path" ] || return 1
  CODEX_SWITCHER_SESSION_PATH="$path" python3 <<'PY'
import json, os, sys

path = os.environ["CODEX_SWITCHER_SESSION_PATH"]
topic = ""
name_file = path + ".name"
if os.path.isfile(name_file):
    try:
        with open(name_file, encoding="utf-8", errors="replace") as nf:
            topic = nf.readline().strip()
    except OSError:
        pass
if not topic:
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if isinstance(d, dict) and d.get("type") == "event_msg":
                    pl = d.get("payload") or {}
                    if pl.get("type") == "user_message" and pl.get("message", "").strip():
                        topic = pl.get("message", "").strip()
                        break
    except OSError:
        pass
topic = " ".join(topic.split())
if len(topic) > 60:
    topic = topic[:57] + "..."
sys.stdout.write(topic)
PY
}

remove_session() {
  sid=${1:-}
  [ -n "$sid" ] || die "请指定要删除的会话 ID，例如：codex-switcher sessions remove <会话ID>"
  command -v python3 >/dev/null 2>&1 || die "需要 python3 才能操作会话。"
  target=$(find_session_file "$sid")
  [ -n "$target" ] || die "未找到会话：$sid"
  topic=$(session_topic "$target")
  [ -n "$topic" ] || topic="（无主题）"
  printf "会话 %s\n主题：%s\n确定删除该会话文件？[y/N] " "$sid" "$topic"
  read -r answer
  case "$answer" in
    y|Y|yes|YES) ;;
    *) echo "已取消。"; exit 0 ;;
  esac
  rm -f "$target" "$target.name"
  echo "已删除会话：$sid"
}

rename_session() {
  sid=${1:-}
  topic=${2:-}
  [ -n "$sid" ] || die "请指定会话 ID，例如：codex-switcher sessions rename <会话ID> 新主题"
  command -v python3 >/dev/null 2>&1 || die "需要 python3 才能操作会话。"
  target=$(find_session_file "$sid")
  [ -n "$target" ] || die "未找到会话：$sid"
  if [ -n "$topic" ]; then
    topic=$(printf '%s' "$topic" | tr '\t\r\n' '   ' | sed 's/  */ /g' | sed 's/^ //;s/ $//')
    [ -n "$topic" ] || die "主题不能为空。"
    printf '%s\n' "$topic" > "$target.name"
    chmod 600 "$target.name"
    echo "已将会话 $sid 重命名为：$topic"
  else
    rm -f "$target.name"
    echo "已清除会话 $sid 的自定义名称。"
  fi
}

list_session_completions() {
  command -v python3 >/dev/null 2>&1 || return 0
  CODEX_SWITCHER_HOME="$codex_home" python3 <<'PY'
import glob, json, os, re, sys

codex_home = os.environ["CODEX_SWITCHER_HOME"]
sessions_dir = os.path.join(codex_home, "sessions")
rows = []

if os.path.isdir(sessions_dir):
    for p in glob.glob(os.path.join(sessions_dir, "**", "*.jsonl"), recursive=True):
        topic = ""
        name_file = p + ".name"
        if os.path.isfile(name_file):
            try:
                with open(name_file, encoding="utf-8", errors="replace") as nf:
                    topic = nf.readline().strip()
            except OSError:
                pass
        if not topic:
            try:
                with open(p, encoding="utf-8", errors="replace") as f:
                    for line in f:
                        try:
                            d = json.loads(line)
                        except Exception:
                            continue
                        if isinstance(d, dict) and d.get("type") == "event_msg":
                            pl = d.get("payload") or {}
                            if pl.get("type") == "user_message" and pl.get("message", "").strip():
                                topic = pl.get("message", "").strip()
                                break
            except OSError:
                pass
        stem = os.path.basename(p)
        if stem.endswith(".jsonl"):
            stem = stem[:-6]
        m = re.search(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", stem)
        sid = m.group(0) if m else stem.rsplit("-", 1)[-1]
        topic = " ".join(topic.split()).replace("\t", " ")
        if len(topic) > 60:
            topic = topic[:57] + "..."
        rows.append((sid, topic))

rows.sort(key=lambda r: r[0])
out = "".join("%s\t%s\n" % (sid, topic) for sid, topic in rows)
try:
    sys.stdout.write(out)
except BrokenPipeError:
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, sys.stdout.fileno())
PY
}

completion_candidates() {
  # $@ 为已输入参数（含正在补全的当前词）；位置 = $# - 1
  if [ "$#" -le 1 ]; then
    # 位置 0：命令名位置（含 profile 名）
    printf '%s\n' list create edit delete remove rm sync-models sessions model doctor vscode official default reset restore help version completion -h --help -V --version
    list_profiles
    return 0
  fi
  case "$1" in
    create|official|default|reset|restore|help|version|__complete)
      return 0
      ;;
    list)
      [ "$#" -eq 2 ] && printf '%s\n' --json
      ;;
    edit|sync-models)
      [ "$#" -eq 2 ] && list_profiles
      ;;
    model)
      if [ "$#" -eq 2 ]; then
        list_profiles
      elif [ "$#" -eq 3 ]; then
        list_profile_models "${2:-}" 2>/dev/null || true
      fi
      ;;
    doctor)
      [ "$#" -eq 2 ] && list_profiles
      ;;
    vscode)
      if [ "$#" -eq 2 ]; then
        list_profiles
      elif [ "$#" -eq 3 ]; then
        printf '%s\n' --isolated
      fi
      ;;
    delete|remove|rm)
      if [ "$#" -eq 2 ]; then
        printf '%s\n' --yes
        list_profiles
      elif [ "$#" -eq 3 ]; then
        printf '%s\n' --yes
      fi
      ;;
    sessions)
      if [ "$#" -eq 2 ]; then
        printf '%s\n' remove rm rename
      elif [ "$#" -eq 3 ] && { [ "$2" = "remove" ] || [ "$2" = "rm" ] || [ "$2" = "rename" ]; }; then
        list_session_completions
      fi
      ;;
    completion)
      [ "$#" -eq 2 ] && printf '%s\n' bash zsh fish powershell
      ;;
  esac
}

print_completion() {
  shell=$1
  case "$shell" in
    bash) name=codex-switcher.bash ;;
    zsh) name=_codex-switcher.zsh ;;
    fish) name=codex-switcher.fish ;;
    powershell) name=codex-switcher-completion.ps1 ;;
    *) return 1 ;;
  esac
  script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
  for dir in \
    "$script_dir/../completions" \
    "$script_dir/../../windows/completions" \
    "$HOME/.local/share/codex-switcher/completions"; do
    if [ -f "$dir/$name" ]; then
      cat "$dir/$name"
      return 0
    fi
  done
  die "找不到 $name；请从源码目录运行，或重新执行 install.sh 安装补全文件。"
}

usage() {
  cat <<'EOF'
用法：
  codex-switcher                         交互选择 profile 并启动 Codex
  codex-switcher official                使用默认/官方配置启动 Codex
  codex-switcher vscode <名称>           带指定供应商环境启动 VS Code Codex
  codex-switcher list [--json]           列出已有 profile（--json 输出机器可读格式）
  codex-switcher sessions                列出全部会话（跨目录，含主题与所属目录）
  codex-switcher sessions remove <ID>   删除指定会话（rm 亦可，删除前显示主题确认）
  codex-switcher sessions rename <ID> <主题>  重命名会话（主题留空则清除自定义名）
  codex-switcher create <名称>           创建新的 profile（干净模板，不会复制主配置）
  codex-switcher edit <名称>             用 vim/指定编辑器打开对应 TOML，退出后自动同步模型
  codex-switcher sync-models <名称>      查询中转站 <base_url>/models 并自动生成/合并模型目录
  codex-switcher model <名称> [模型名]   查看/切换 profile 的 model（不带模型名时交互选择）
  codex-switcher doctor [名称]           诊断 Codex 与 profile 环境（缺省检查全部 profile）
  codex-switcher delete <名称> [--yes]   删除一个 profile（默认需要确认）
  codex-switcher completion <shell>      输出 bash/zsh/fish/powershell 补全脚本
  codex-switcher <名称> [Codex参数...]   启动指定 profile

官方回退别名：official、default、reset、restore
所有第三方 Provider（包括 DeepSeek）都走同一个通用流程：
  create 生成干净模板，edit 填写 base_url 与 Key，退出编辑或执行 sync-models 时
  自动查询 <base_url>/models 并生成 <名称>-models.json，/model 直接切换该中转站
  支持的所有模型（只增不减、自动备份、权限 600）。
环境变量：CODEX_SWITCHER_NO_AUTO_SYNC=1 可关闭自动同步，只保留手动 sync-models。
编辑器：优先使用 CODEX_SWITCHER_EDITOR，其次 VISUAL/EDITOR，默认 vim
profile：<Codex 主目录>/<名称>.config.toml（默认 ~/.codex，可用 CODEX_SWITCHER_CODEX_HOME 覆盖）
认证文件 ~/.codex/auth.json 不会被复制、删除或切换。

VS Code：vscode 命令会让 VS Code 继承对应的 CODEX_HOME。
已有 VS Code 窗口需要完全退出后重新启动；--isolated 可启动独立窗口。
EOF
}

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  -V|--version|version)
    echo "codex-switcher 3.3.0"
    exit 0
    ;;
  list)
    if [ "${2:-}" = "--json" ]; then
      list_profiles_json
      exit 0
    fi
    [ "$#" -gt 1 ] && die "list 命令只支持 --json 参数。"
    list_profiles
    exit 0
    ;;
  model)
    name=${2:-}
    [ -n "$name" ] || die "请指定 profile，例如：codex-switcher model provider-a"
    valid_name "$name" || die "无效 profile 名称。"
    reserved_name "$name" && die "'$name' 是保留命令名，请换一个 profile 名称。"
    target="$codex_home/$name.config.toml"
    [ -f "$target" ] || die "不存在 profile：$name"
    new_model=${3:-}
    if [ -n "$new_model" ]; then
      valid_name "$new_model" || die "无效模型名。"
      catalog_models=$(list_profile_models "$name" 2>/dev/null || true)
      case "$catalog_models" in
        *"$new_model"*) ;;
        *) echo "警告：$new_model 不在 $name 的模型目录中；可执行 codex-switcher sync-models $name 刷新。" >&2 ;;
      esac
      set_profile_model "$name" "$new_model"
      echo "已将 $name 的 model 切换为：$new_model"
      exit 0
    fi
    current=$(toml_value "$target" model)
    echo "当前 model：${current:-（未设置）}"
    models=$(list_profile_models "$name")
    [ -n "$models" ] || die "模型目录为空：$name-models.json"
    i=1
    for m in $models; do
      printf '  %s) %s\n' "$i" "$m"
      i=$((i + 1))
    done
    printf '选择编号切换（回车取消）：'
    if ! read -r choice || [ -z "$choice" ]; then
      echo "已取消。"
      exit 0
    fi
    new_model=$(printf '%s\n' "$models" | sed -n "${choice}p")
    [ -n "$new_model" ] || die "无效选择。"
    set_profile_model "$name" "$new_model"
    echo "已将 $name 的 model 切换为：$new_model"
    exit 0
    ;;
  doctor)
    only=${2:-}
    command -v python3 >/dev/null 2>&1 || die "需要 python3 才能运行 doctor。"
    problems=0
    echo "== codex-switcher doctor =="
    if [ -n "$codex_bin" ]; then
      echo "[OK] Codex CLI：$codex_bin"
    else
      echo "[警告] 未找到 Codex CLI；可设置 CODEX_SWITCHER_CODEX_BIN"
      problems=$((problems + 1))
    fi
    echo "Codex 主目录：$codex_home"
    if [ -n "$only" ]; then
      valid_name "$only" || die "无效 profile 名称。"
      reserved_name "$only" && die "'$only' 是保留命令名，请换一个 profile 名称。"
      profiles="$only"
    else
      profiles=$(list_profiles)
    fi
    if [ -z "$profiles" ]; then
      echo "[警告] 没有任何 profile；先运行 codex-switcher create <名称>"
      problems=$((problems + 1))
    fi
    for name in $profiles; do
      target="$codex_home/$name.config.toml"
      echo "---- profile：$name ----"
      if [ ! -f "$target" ]; then
        echo "[警告] 配置文件不存在：$target"
        problems=$((problems + 1))
        continue
      fi
      base_url=$(toml_value "$target" base_url)
      key=$(toml_value "$target" experimental_bearer_token)
      catalog=$(toml_value "$target" model_catalog_json)
      [ -n "$catalog" ] || catalog="$name-models.json"
      catalog_file="$codex_home/$catalog"
      if [ -z "$base_url" ]; then
        echo "[警告] 未配置 base_url；用 codex-switcher edit $name 填写中转站地址"
        problems=$((problems + 1))
      else
        echo "[OK] base_url：$base_url"
      fi
      if [ -z "$key" ] || key_is_placeholder "$key"; then
        echo "[警告] experimental_bearer_token 为空或仍是占位符；用 codex-switcher edit $name 填写 Key"
        problems=$((problems + 1))
      else
        echo "[OK] 已配置 API Key"
      fi
      if [ -f "$catalog_file" ]; then
        count=$(python3 -c '
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        d = json.load(f)
except Exception:
    sys.exit(1)
models = d.get("models", []) if isinstance(d, dict) else d
print(len([m for m in models if isinstance(m, dict) and m.get("slug")]))
' "$catalog_file" 2>/dev/null || echo 0)
        if [ "$count" -gt 0 ] 2>/dev/null; then
          echo "[OK] 模型目录：$catalog_file（$count 个模型）"
        else
          echo "[警告] 模型目录为空或无法解析：$catalog_file；可执行 codex-switcher sync-models $name"
          problems=$((problems + 1))
        fi
      else
        echo "[警告] 模型目录不存在：$catalog_file；可执行 codex-switcher sync-models $name"
        problems=$((problems + 1))
      fi
    done
    if [ "$problems" -eq 0 ]; then
      echo "全部检查通过。"
      exit 0
    fi
    echo "共发现 $problems 个问题。"
    exit 1
    ;;
  __complete)
    shift
    completion_candidates "$@"
    exit 0
    ;;
  completion)
    shell=${2:-}
    case "$shell" in
      bash|zsh|fish|powershell) ;;
      *) die "请指定 shell：bash、zsh、fish 或 powershell。" ;;
    esac
    print_completion "$shell"
    exit 0
    ;;
  sessions)
    case "${2:-}" in
      remove|rm)
        remove_session "${3:-}"
        exit 0
        ;;
      rename)
        rename_session "${3:-}" "${4:-}"
        exit 0
        ;;
      *)
        [ "$#" -gt 1 ] && die "sessions 命令不接受额外参数。用法：codex-switcher sessions [remove|rm <会话ID>]"
        list_sessions
        exit 0
        ;;
    esac
    exit 0
    ;;
  create)
    name=${2:-}
    valid_name "$name" || die "名称只能包含字母、数字、点、下划线和短横线。"
    reserved_name "$name" && die "名称 '$name' 是保留命令名，请换一个 profile 名称。"
    target="$codex_home/$name.config.toml"
    [ -e "$target" ] && die "profile 已存在，不会覆盖：$target"
    write_profile_template "$name"
    echo "已创建干净模板：$target"
    echo "下一步：codex-switcher edit $name  填写 base_url 与 Key；退出编辑后会自动同步模型目录。"
    exit 0
    ;;

  sync-models)
    name=${2:-}
    [ -n "$name" ] || die "请指定 profile 名称，例如：codex-switcher sync-models provider-a"
    valid_name "$name" || die "无效 profile 名称。"
    sync_models "$name"
    exit 0
    ;;
  edit)
    name=${2:-}
    [ -n "$name" ] || die "请指定 profile 名称，例如：codex-switcher edit provider-a"
    valid_name "$name" || die "无效 profile 名称。"
    case "$name" in
      official|default|reset|restore) target="$codex_home/config.toml" ;;
      *) target="$codex_home/$name.config.toml" ;;
    esac
    [ -f "$target" ] || die "找不到配置文件：$target"
    editor=${CODEX_SWITCHER_EDITOR:-${VISUAL:-${EDITOR:-vim}}}
    editor_bin=$(command -v "$editor" 2>/dev/null || true)
    [ -n "$editor_bin" ] || die "找不到编辑器 '$editor'。可设置 CODEX_SWITCHER_EDITOR，或安装 vim。"
    "$editor_bin" "$target"
    rc=$?
    if [ "$rc" -ne 0 ]; then
      exit "$rc"
    fi
    case "$name" in
      official|default|reset|restore) exit 0 ;;
    esac
    if [ "${CODEX_SWITCHER_NO_AUTO_SYNC:-0}" != "1" ]; then
      echo "编辑完成，正在同步模型目录..."
      if sync_models "$name"; then
        echo "模型目录同步完成。"
      else
        echo "错误：模型同步失败；请根据上面的提示修复，或稍后执行 codex-switcher sync-models $name。" >&2
        exit 1
      fi
    fi
    exit 0
    ;;
  delete|remove|rm)
    name=${2:-}
    [ -n "$name" ] || die "请指定要删除的 profile，例如：codex-switcher delete provider-a"
    if [ "$name" = "--yes" ]; then
      name=${3:-}
      yes=1
    else
      yes=0
      [ "${3:-}" = "--yes" ] && yes=1
    fi
    valid_name "$name" || die "无效 profile 名称。"
    case "$name" in
      official|default|reset|restore)
        target="$codex_home/$name.config.toml"
        ;;
      *)
        target="$codex_home/$name.config.toml"
        ;;
    esac
    [ -f "$target" ] || die "不存在 profile：$name"
    if [ "$yes" -ne 1 ]; then
      printf "确定删除 profile '%s'？只删除该 profile，不影响默认配置和 auth.json。[y/N] " "$name"
      read -r answer
      case "$answer" in
        y|Y|yes|YES) ;;
        *) echo "已取消。"; exit 0 ;;
      esac
    fi
    rm "$target"
    echo "已删除 profile：$name"
    exit 0
    ;;
  vscode)
    name=${2:-}
    [ -n "$name" ] || die "请指定供应商，例如：codex-switcher vscode provider-a"
    valid_name "$name" || die "无效 profile 名称。"

    case "$name" in
      official|default|reset|restore)
        prepare_official_environment
        vscode_home="$codex_home"
        ;;
      *)
        profile_file="$codex_home/$name.config.toml"
        [ -f "$profile_file" ] || die "不存在 profile：$name"
        vscode_home="$codex_home/codex-switcher-vscode/$name"
        mkdir -p "$vscode_home"
        cp "$profile_file" "$vscode_home/config.toml"
        chmod 600 "$vscode_home/config.toml"
        # Reuse the existing login without copying the secret file.
        if [ -f "$codex_home/auth.json" ] && [ ! -e "$vscode_home/auth.json" ]; then
          ln -s "$codex_home/auth.json" "$vscode_home/auth.json"
        fi
        ;;
    esac

    vscode_bin=$(find_vscode || true)
    [ -n "$vscode_bin" ] || die "找不到 VS Code 命令。请安装 code 命令，或设置 CODEX_SWITCHER_VSCODE_BIN。"
    shift 2
    isolated=0
    if [ "${1:-}" = "--isolated" ]; then
      isolated=1
      shift
    fi
    echo "正在启动 VS Code Codex，供应商：$name"
    echo "CODEX_HOME=$vscode_home"
    if [ "$isolated" -eq 0 ]; then
      echo "如果 VS Code 已经打开，请先完全退出再运行；否则旧窗口可能继续使用旧供应商。"
      unset ELECTRON_RUN_AS_NODE
      CODEX_HOME="$vscode_home" exec "$vscode_bin" --new-window "$@"
    else
      data_home="$codex_home/codex-switcher-vscode-data/$name"
      mkdir -p "$data_home"
      echo "使用独立 VS Code 用户数据目录：$data_home"
      unset ELECTRON_RUN_AS_NODE
      CODEX_HOME="$vscode_home" exec "$vscode_bin" --new-window --user-data-dir "$data_home" "$@"
    fi
    ;;
  official|default|reset|restore)
    prepare_official_environment
    echo "已清理第三方 Provider 环境，正在使用官方 OpenAI Codex。"
    unset ELECTRON_RUN_AS_NODE
    shift
    CODEX_HOME="$codex_home" exec "$codex_bin" \
      -c 'model_provider="openai"' \
      -c 'model="gpt-5.4"' \
      "$@"
    ;;
esac

if [ "$#" -gt 0 ] && [ "${1#-}" != "$1" ]; then
  die "请先指定 profile 名称；使用 codex-switcher --help 查看用法。"
fi

profile=${1:-}
if [ -z "$profile" ]; then
  profiles=$(list_profiles)
  if [ -z "$profiles" ]; then
    die "还没有 profile。先运行：codex-switcher create <名称>"
  fi
  echo "选择 Codex profile："
  i=1
  for item in $profiles; do
    printf '  %s) %s\n' "$i" "$item"
    i=$((i + 1))
  done
  printf '编号：'
  read -r choice
  profile=$(printf '%s\n' "$profiles" | sed -n "${choice}p")
  [ -n "$profile" ] || die "无效选择。"
else
  shift
fi

valid_name "$profile" || die "无效 profile 名称。"
reserved_name "$profile" && die "'$profile' 是保留命令名，请使用 codex-switcher official 或换一个 profile 名称。"
target="$codex_home/$profile.config.toml"
[ -f "$target" ] || die "不存在 profile：$profile"

# 模型目录不存在时自动同步一次（不每次同步）
if [ "${CODEX_SWITCHER_NO_AUTO_SYNC:-0}" != "1" ]; then
  case "$profile" in
    official|default|reset|restore) ;;
    *)
      if [ ! -f "$codex_home/$profile-models.json" ]; then
        if sync_models "$profile"; then
          echo "已自动生成模型目录：$codex_home/$profile-models.json"
        else
          echo "警告：模型同步失败，/model 可能不可用；可执行 codex-switcher sync-models $profile 重试。" >&2
        fi
      fi
      ;;
  esac
fi

unset ELECTRON_RUN_AS_NODE
CODEX_HOME="$codex_home" exec "$codex_bin" --profile "$profile" "$@"
